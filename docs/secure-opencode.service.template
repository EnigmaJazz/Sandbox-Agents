# Secure OpenCode server (user systemd unit, Gate 9).
# Reviewed and installed manually by the user at ~/.config/systemd/user/.
# Not installed by any repo script. See docs/manual-verification.md Gate 9.
[Unit]
Description=Secure OpenCode server
PartOf=graphical-session.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/opencode-sandbox-control
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/opencode-sandbox-control
ExecStart=/home/james/agent-sandbox-integration/scripts/start-secure-opencode
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
