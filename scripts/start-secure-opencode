#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/secure-launcher.conf"
CONTROL_DIR_OVERRIDE=""
[[ "${1:-}" == "--control-dir" ]] && CONTROL_DIR_OVERRIDE="${2:?}"
[[ -n "$CONTROL_DIR_OVERRIDE" ]] && CONTROL_DIR="$CONTROL_DIR_OVERRIDE"
BOOTSTRAP_WORKSPACE="/home/james/ai-workspace/workflow_optimisation"
CWD_CANON="$(realpath -m "$PWD")"
CONTROL_CANON="$(realpath -m "$CONTROL_DIR")"
BOOTSTRAP_CANON="$(realpath -m "$BOOTSTRAP_WORKSPACE")"
if [[ "$CWD_CANON" == "$CONTROL_CANON" || "$CWD_CANON" == "$BOOTSTRAP_CANON" ]]; then
  : # allowed: control dir or approved bootstrap workspace
else
  for root in "${PROJECT_ROOTS[@]}"; do
    [[ "$(realpath -m "$root")" == "$BOOTSTRAP_CANON" ]] && continue
    ROOT_CANON="$(realpath -m "$root")"
    case "$CWD_CANON" in "$ROOT_CANON"|"$ROOT_CANON"/*)
      echo "refusing to start secure opencode from project dir: $PWD" >&2
      echo "cd to the control dir first: $CONTROL_DIR" >&2
      echo "or to the approved bootstrap workspace: $BOOTSTRAP_WORKSPACE" >&2
      exit 3 ;;
    esac
  done
fi
if [[ -d "$CWD_CANON/.git" && "$CWD_CANON" != "$CONTROL_CANON" && "$CWD_CANON" != "$BOOTSTRAP_CANON" ]]; then
  echo "refusing to start secure opencode from a git checkout: $PWD" >&2; exit 3
fi
for bin in "$NONO_BIN" "$OPENCODE_BIN"; do [[ -x "$bin" ]] || { echo "missing required binary: $bin" >&2; exit 4; }; done
[[ -f "$SCRIPT_DIR/../nono/profile/opencode-secure.json" ]] || { echo "nono profile missing in repo; cannot continue" >&2; exit 4; }
mkdir -p "$CONTROL_DIR"; chmod 700 "$CONTROL_DIR"
echo "validating nono profile..."
"$NONO_BIN" profile validate "$SCRIPT_DIR/../nono/profile/opencode-secure.json" >/dev/null
"$NONO_BIN" run --dry-run --profile "$SCRIPT_DIR/../nono/profile/opencode-secure.json" -- true >/dev/null
echo "starting secured opencode at ${OPENCODE_HOSTNAME}:${OPENCODE_PORT} (profile: ${NONO_PROFILE})"
echo "control dir: $CONTROL_DIR"
echo "bootstrap workspace: $BOOTSTRAP_WORKSPACE (cwd: $PWD)"
exec "$NONO_BIN" run --profile "$SCRIPT_DIR/../nono/profile/opencode-secure.json" -- "$OPENCODE_BIN" serve --hostname "$OPENCODE_HOSTNAME" --port "$OPENCODE_PORT"
