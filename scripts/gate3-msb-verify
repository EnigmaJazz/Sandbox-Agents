#!/usr/bin/env bash
#
# gate3-msb-verify — Gate 3 manual verification of Microsandbox (msb).
#
# SYSTEM_PROMPT.md §27 Gate 3: "Microsandbox manually verified".
# The exact command sequence from docs/manual-verification.md, packaged with
# PASS/FAIL reporting so the output can be pasted back for review.
#
# Creates TWO throwaway debian sandboxes (gate3-smoke, gate3-conf-test),
# verifies broker policy values and isolation, then removes them.
# Requires: msb on PATH (msb 0.6.9 verified).
#
# This is a manual user gate — it is NOT part of any agent workflow and does
# NOT install anything. It only uses msb, /tmp, and the msb sandbox pool.
set -uo pipefail

PASS=0
FAIL=0
ok()   { PASS=$((PASS + 1)); printf 'PASS  %s\n' "$1"; }
bad()  { FAIL=$((FAIL + 1)); printf 'FAIL  %s\n' "$1"; }
note() { printf 'NOTE  %s\n' "$1"; }

echo "== Gate 3: Microsandbox manual verification — $(date -Is) =="
echo

# ── 0) Preconditions ────────────────────────────────────────────────────────
if msb doctor >/dev/null 2>&1; then
  ok "msb doctor (KVM access unchanged — read/write for user)"
else
  bad "msb doctor"
  msb doctor 2>&1 | tail -5
fi

if msb image list 2>/dev/null | grep -q '^debian'; then
  ok "image 'debian' present"
else
  bad "image 'debian' present"
  msb image list 2>&1 | head -5
fi

# Clean up leftovers from a previous run — the whole gate3-* namespace
# (aborted runs can leave extra named sandboxes behind).
for leftover in $(msb list 2>/dev/null | awk '{print $1}' | grep '^gate3-'); do
  msb stop "$leftover" >/dev/null 2>&1 || true
  msb remove "$leftover" >/dev/null 2>&1 || true
done
rm -rf /tmp/gate3
mkdir -p /tmp/gate3

# ── 1) Throwaway sandbox — CLI-flags form (broker policy values) ───────────
if msb create -n gate3-smoke debian \
  -c 2 --max-cpus 2 -m 2G --max-memory 2G \
  --no-net -w /work --mkdir /work -H gate3-smoke \
  >/tmp/gate3/create.log 2>&1; then
  ok "create gate3-smoke (2 vCPU / 2 GiB, --no-net, workdir /work)"
else
  bad "create gate3-smoke"
  tail -5 /tmp/gate3/create.log
  echo "== RESULT: $PASS passed, $FAIL failed (aborted at create) =="
  exit 1
fi

# ── 2) It is running ────────────────────────────────────────────────────────
if msb list 2>/dev/null | grep -q gate3-smoke; then
  ok "gate3-smoke listed by msb"
else
  bad "gate3-smoke listed by msb"
fi

# ── 3) Exec works; workdir is /work (exec needs its own -w; the broker
#        always passes cwd, Gate 3 finding) ──────────────────────────────────
# msb prints a '   • Backend      local' status line to STDOUT before/after
# the real output — filter it out and take the last remaining line.
worker_pwd() {
  msb exec -w /work "$1" -- pwd < /dev/null 2>/dev/null | tr -d '\r' | grep -v '^[[:space:]]*•' | tail -1
}
val=$(worker_pwd gate3-smoke)
if [ "$val" = "/work" ]; then
  ok "exec pwd = /work (with -w, as the broker does)"
else
  bad "exec pwd = /work (captured: [$val])"
fi

if msb exec gate3-smoke -- cat /etc/os-release < /dev/null >/dev/null 2>&1; then
  ok "exec cat /etc/os-release"
else
  bad "exec cat /etc/os-release"
fi

# ── 4) Isolation: the host is NOT mounted (S11) ─────────────────────────────
# The debian image ships its OWN empty /home — probe a host-specific path.
if ! msb exec gate3-smoke -- ls /home/james < /dev/null >/dev/null 2>&1; then
  ok "host /home/james not visible in guest"
else
  bad "host /home/james not visible in guest"
fi

# /dev/kvm: msb exposes the HOST kvm (10,232) to the guest, mode 600 root:root.
# A root guest user can open it; the broker's mitigation is non-root exec (-u
# nobody). Verify BOTH: root CAN open (documents exposure) and nobody CANNOT.
if msb exec gate3-smoke -- sh -c 'exec 3<>/dev/kvm 2>/dev/null' < /dev/null >/dev/null 2>&1; then
  note "host /dev/kvm is openable by guest root (msb passthrough — documented)"
else
  ok "host /dev/kvm not openable by guest root"
fi
if ! msb exec -u nobody gate3-smoke -- sh -c 'exec 3<>/dev/kvm 2>/dev/null' < /dev/null >/dev/null 2>&1; then
  ok "/dev/kvm denied to non-root guest user (broker runs -u nobody)"
else
  bad "/dev/kvm denied to non-root guest user"
fi

if ! msb exec gate3-smoke -- test -S /var/run/docker.sock < /dev/null 2>/dev/null; then
  ok "docker socket not exposed to guest"
else
  bad "docker socket not exposed to guest"
fi

# ── 5) Network deny-by-default (S12) ────────────────────────────────────────
# Route table: the guest has its own link-local/subnet routes by design; the
# FUNCTIONAL check is reachability. Route count is informational.
routes=$(msb exec gate3-smoke -- sh -c 'wc -l < /proc/net/route' < /dev/null 2>/dev/null || echo -1)
note "guest /proc/net/route has $routes lines (own subnet routes are normal)"

if msb exec gate3-smoke -- sh -c 'command -v getent' < /dev/null >/dev/null 2>&1; then
  if msb exec gate3-smoke -- getent hosts 100.90.20.31 < /dev/null >/dev/null 2>&1; then
    bad "LAN host unreachable (getent RESOLVED it — network leak!)"
  else
    ok "LAN host unreachable via getent"
  fi
else
  note "getent absent in image — no functional network probe available"
fi

# ── 6) Copy round-trip (the broker's result-export path) ────────────────────
# msb copy REFUSES symlink escapes (security-positive, e.g. /etc/os-release is
# a symlink) — so copy a REGULAR file: create one in the guest first.
if msb exec -w /work gate3-smoke -- sh -c 'echo gate3 > /work/copy-probe.txt' < /dev/null >/dev/null 2>&1 \
  && msb copy gate3-smoke:/work/copy-probe.txt /tmp/gate3/copy-probe.txt >/dev/null 2>&1 \
  && grep -q gate3 /tmp/gate3/copy-probe.txt; then
  ok "copy sandbox -> host (regular file)"
else
  bad "copy sandbox -> host (regular file)"
fi

if msb copy /etc/hostname gate3-smoke:/tmp/hostname >/dev/null 2>&1; then
  ok "copy host -> sandbox (/etc/hostname)"
else
  bad "copy host -> sandbox (/etc/hostname)"
fi

# ── 7) Broker-shaped conf files — schema proof point (Gate 3 findings) ─────
# Conf schemas were corrected against msb 0.6.9 during Gate 3:
#   runtime.conf: security + workdir (capabilities is NOT a field)
#   net.conf:     policy "none" (deny-by-default; enum none|public|open)
#   resource.conf: cpus + memory as a SIZE STRING
#   fs.conf:      {} (no mounts)
#   secret.conf:  {} (unwrapped — no `secrets` wrapper)
# plus --mkdir /work.
printf '{"security":"restricted","workdir":"/work"}' >/tmp/gate3/runtime.conf
printf '{"policy":"none"}' >/tmp/gate3/net.conf
printf '{"cpus":2,"memory":"2048M"}' >/tmp/gate3/resource.conf
printf '{}' >/tmp/gate3/fs.conf
printf '{}' >/tmp/gate3/secret.conf

if msb create -n gate3-conf-test debian \
  --conf /tmp/gate3/runtime.conf \
  --net-conf /tmp/gate3/net.conf \
  --resource-conf /tmp/gate3/resource.conf \
  --fs-conf /tmp/gate3/fs.conf \
  --secret-conf /tmp/gate3/secret.conf \
  -c 2 --max-cpus 2 --mkdir /work \
  >/tmp/gate3/conf-create.log 2>&1; then
  ok "broker-shaped conf-file create (net/resource/fs/runtime/secret)"
  if [ "$(worker_pwd gate3-conf-test)" = "/work" ]; then
    ok "conf-test exec pwd = /work"
  else
    bad "conf-test exec pwd = /work (captured: [$(worker_pwd gate3-conf-test)])"
  fi
  if ! msb exec -u nobody gate3-conf-test -- sh -c 'exec 3<>/dev/kvm 2>/dev/null' < /dev/null >/dev/null 2>&1; then
    ok "conf-test /dev/kvm denied to non-root guest user"
  else
    bad "conf-test /dev/kvm denied to non-root guest user"
  fi
else
  bad "broker-shaped conf-file create — SCHEMA FINDING: fix broker/src/msb.ts"
  tail -8 /tmp/gate3/conf-create.log
fi

# ── 8) Cleanup — remove the whole gate3-* namespace ─────────────────────────
for leftover in $(msb list 2>/dev/null | awk '{print $1}' | grep '^gate3-'); do
  msb stop "$leftover" >/dev/null 2>&1 || true
  msb remove "$leftover" >/dev/null 2>&1 || true
done
left=$(msb list 2>/dev/null | grep -c '^gate3-' || true)
if [ "$left" = "0" ]; then
  ok "cleanup (no gate3 sandboxes left)"
else
  bad "cleanup (left: $left)"
fi

echo
echo "== RESULT: $PASS passed, $FAIL failed — $(date -Is) =="
echo "Logs kept at /tmp/gate3/ (create.log, conf-create.log, os-release)"
exit $((FAIL > 0 ? 1 : 0))
