#!/usr/bin/env bash
#
# install-user-files — idempotent installer for the LATER gates (Gate 2+).
#
# NOT to be run at Gate 1 and MUST NOT be run by an agent without the user's
# explicit manual approval after reviewing docs/manual-verification.md.
# Default mode is --dry-run: it only prints what it would do and the diffs.
#
# Installs (in order):
#   1. nono profile        -> ~/.config/nono/profiles/opencode-secure.json
#   2. opencode config     -> merges the permission FRAGMENT into the user's
#                             opencode.json — creates a diff artifact and a
#                             .bak first; NEVER overwrites silently
#   3. systemd user unit   -> ~/.config/systemd/user/sandbox-broker.service
#   4. opencode plugins    -> ~/.config/opencode/plugins/{sandbox-tools,routing-guard,lib}
#
# Every installed file gets a timestamped .bak unless one exists already.
# A journal of install actions is written to the broker state dir so
# scripts/rollback can reverse them exactly.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=scripts/secure-launcher.conf
source "$SCRIPT_DIR/secure-launcher.conf"

STATE_DIR="${BROKER_STATE_DIR:-$HOME/.local/state/opencode-sandbox}"
JOURNAL="$STATE_DIR/install-journal.tsv"

APPLY=0
VERIFY=0
PRUNE_BACKUPS=0
DRY_RUN=0
for argument in "$@"; do
  case "$argument" in
    --apply) APPLY=1 ;;
    --verify) VERIFY=1 ;;
    --prune-backups) PRUNE_BACKUPS=1 ;;
    --dry-run) DRY_RUN=1 ;;
    *) echo "usage: $0 [--dry-run|--apply|--verify|--prune-backups]" >&2; exit 2 ;;
  esac
done
if [[ "$VERIFY" == "1" && "$PRUNE_BACKUPS" == "1" ]]; then
  echo "[install] backup pruning is not allowed in verify mode" >&2
  exit 2
fi
if [[ "$PRUNE_BACKUPS" == "1" && "$APPLY" == "1" ]]; then
  echo "[install] --prune-backups cannot be combined with --apply" >&2
  exit 2
fi
if [[ "$DRY_RUN" == "1" && "$APPLY" == "1" ]]; then
  echo "[install] --dry-run cannot be combined with --apply" >&2
  exit 2
fi
if [[ "$APPLY" != "1" && "$VERIFY" != "1" && "$PRUNE_BACKUPS" != "1" ]]; then
  DRY_RUN=1
fi

# Only an applying install may create or modify installer state.
if [[ "$APPLY" == "1" ]]; then
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
fi
DRIFT=0
VERIFIED_COUNT=0
VERIFY_EXPECTED_DESTINATIONS=()
VERIFY_STALE_CHECK_SKIPPED=0

log() {
  if [[ "$*" == error:* ]]; then
    printf '[install] %s\n' "$*" >&2
  else
    printf '[install] %s\n' "$*"
  fi
}

journal() { # action kind source dest
  if [[ "$APPLY" == "1" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$1" "$2" "$3" "$4" >>"$JOURNAL"
  fi
}

prune_destination_backups() { # destination [protected backup]
  local destination="$1" protected="${2:-}" directory name escaped_name output
  directory="$(dirname "$destination")"
  name="$(basename "$destination")"
  escaped_name="$(printf '%s' "$name" | sed 's/[][\\.^$*+?{}|()]/\\&/g')"
  if ! output="$(find "$directory" -maxdepth 1 -type f -regextype posix-extended -regex ".*/${escaped_name}\\.bak-[0-9]{14}$" -printf '%f\n' 2>&1)"; then
    log "error: cannot list installer backups for $destination: $output"
    return 1
  fi
  local -a backups=()
  if [[ -n "$output" ]]; then
    mapfile -t backups < <(printf '%s\n' "$output" | sort -r)
  fi
  local retained=0 backup_path
  for backup_path in "${backups[@]}"; do
    backup_path="$directory/$backup_path"
    retained=$((retained + 1))
    if (( retained > 3 )) && [[ "$backup_path" != "$protected" ]]; then
      if [[ "$DRY_RUN" == "1" ]]; then
        log "would delete old backup $backup_path"
      elif rm -- "$backup_path"; then
        log "deleted old backup $backup_path"
      else
        log "error: cannot remove installer backup $backup_path"
        return 1
      fi
    fi
  done
}

backup() { # file -> creates file.bak-<ts> if it exists and no bak yet
  local f="$1"
  [[ -f "$f" ]] || return 0
  local bak="$f.bak-$(date +%Y%m%d%H%M%S)"
  [[ -e "$bak" ]] && return 0
  cp -p "$f" "$bak"
  log "backed up $f -> $bak"
  prune_destination_backups "$f" "$bak"
}

managed_destinations() {
  local root="$HOME/.config/opencode/plugins"
  printf '%s\n' \
    "$HOME/.config/nono/profiles/opencode-secure.json" \
    "$HOME/.config/systemd/user/sandbox-broker.service" \
    "$HOME/.config/opencode-sandbox/broker.env" \
    "$root/sandbox-tools.ts" "$root/routing-guard.ts" \
    "$root/lib/broker-client.ts" "$root/lib/reviewer-relay-core.ts" \
    "$root/lib/session-agent-binding.ts" "$root/reviewer-relay-transport.ts" \
    "$root/lib/host-tool-approval.ts" "$root/lib/apply-preview-guard.ts" \
    "$root/lib/sandbox-edit-core.ts" "$root/lib/legacy-sdd-tools.ts"
}

prune_all_backups() {
  local destination failed=0
  while IFS= read -r destination; do
    prune_destination_backups "$destination" || failed=1
  done < <(managed_destinations)
  return "$failed"
}

count_all_backups() {
  local destination directory name escaped_name output count=0
  while IFS= read -r destination; do
    directory="$(dirname "$destination")"
    name="$(basename "$destination")"
    escaped_name="$(printf '%s' "$name" | sed 's/[][\\.^$*+?{}|()]/\\&/g')"
    if ! output="$(find "$directory" -maxdepth 1 -type f -regextype posix-extended -regex ".*/${escaped_name}\\.bak-[0-9]{14}$" -printf x 2>&1)"; then
      log "error: cannot list installer backups for $destination: $output"
      return 1
    fi
    count=$((count + ${#output}))
  done < <(managed_destinations)
  printf '%s' "$count"
}

if [[ "$PRUNE_BACKUPS" == "1" ]]; then
  if prune_all_backups; then
    log "backup pruning complete"
    exit 0
  fi
  exit 1
fi

install_file() { # src dest mode
  local src="$1" dest="$2" mode="$3"
  if [[ "$VERIFY" == "1" ]]; then
    VERIFY_EXPECTED_DESTINATIONS+=("$dest")
    if [[ -L "$dest" || -d "$dest" ]]; then
      log "drift $dest: type differs (expected regular file)"
      DRIFT=1
    elif [[ ! -e "$dest" ]]; then
      log "drift $dest: absent"
      DRIFT=1
    elif [[ ! -f "$dest" ]]; then
      log "drift $dest: type differs (expected regular file)"
      DRIFT=1
    elif [[ "$dest" == "$HOME/.config/opencode-sandbox/broker.env" ]] && cmp -s "$src" <(grep -v '^BROKER_REVIEW_HELPER_' "$dest"); then
      VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
    elif ! cmp -s "$src" "$dest"; then
      log "drift $dest: content differs"
      DRIFT=1
    elif [[ "$(stat -c '%a' "$dest")" != "${mode#0}" ]]; then
      log "drift $dest: mode differs"
      DRIFT=1
    else
      VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
    fi
    return 0
  fi
  if [[ "$APPLY" == "1" && -f "$dest" ]] && ! cmp -s "$src" "$dest"; then
    backup "$dest"
  fi
  log "install $src -> $dest (mode $mode)"
  if [[ "$APPLY" == "1" ]]; then
    install -m "$mode" "$src" "$dest"
  fi
  journal "file" "$src" "$dest" ""
}

# --- 1. nono profile ---------------------------------------------------------
NONO_DEST="$HOME/.config/nono/profiles/opencode-secure.json"
NONO_SOURCE="$REPO_ROOT/nono/profile/opencode-secure.json"
log "step 1: nono profile"
if [[ "$VERIFY" == "1" ]]; then
  VERIFY_EXPECTED_DESTINATIONS+=("$NONO_DEST")
  if [[ ! -e "$NONO_DEST" && ! -L "$NONO_DEST" ]]; then
    log "drift $NONO_DEST: absent"
    DRIFT=1
  elif [[ ! -L "$NONO_DEST" ]]; then
    log "drift $NONO_DEST: type differs (expected symlink)"
    DRIFT=1
  elif [[ "$(readlink "$NONO_DEST")" != "$NONO_SOURCE" ]]; then
    log "drift $NONO_DEST: link target differs"
    DRIFT=1
  else
    VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
    log "verified $NONO_DEST (expected symlink)"
  fi
else
  if [[ "$APPLY" == "1" ]]; then
    "$NONO_BIN" profile validate "$REPO_ROOT/nono/profile/opencode-secure.json" >/dev/null
  fi
  if [[ -L "$NONO_DEST" ]] && [[ "$(readlink "$NONO_DEST")" == "$NONO_SOURCE" ]]; then
    log "already linked $NONO_DEST -> $NONO_SOURCE"
  else
    if [[ "$APPLY" == "1" && -f "$NONO_DEST" && ! -L "$NONO_DEST" ]]; then
      backup "$NONO_DEST"
    fi
    log "link $NONO_SOURCE -> $NONO_DEST (symlink; not a copy)"
    if [[ "$APPLY" == "1" ]]; then
      mkdir -p "$(dirname "$NONO_DEST")"
      rm -f "$NONO_DEST"
      ln -s "$NONO_SOURCE" "$NONO_DEST"
    fi
    journal "symlink" "$NONO_SOURCE" "$NONO_DEST" ""
  fi
fi

# --- 2. opencode config fragment merge --------------------------------------
log "step 2: opencode permission fragment (merge with diff FIRST)"
OC_CONF="$HOME/.config/opencode/opencode.json"
FRAGMENT="$REPO_ROOT/opencode/config-fragments/sandbox-permissions.jsonc"
if [[ ! -f "$OC_CONF" ]]; then
  log "no opencode.json found at $OC_CONF — fragment NOT applied; refusing to create config"
else
  # Produce the exact diff the user must review before any merge happens.
  # The merge itself is manual: apply sandbox-permissions.jsonc's
  # "permission" block after reviewing this diff. Never merge blindly.
  log "merge target: $OC_CONF"
  log "MERGE IS MANUAL — review fragment + existing config; this script does not merge JSON."
  journal "fragment-review" "$FRAGMENT" "$OC_CONF" "manual merge required"
fi

# --- 3. systemd user unit + broker env -----------------------------------
log "step 3: systemd user unit + broker.env (NOT enabled until Gate 4 review)"
UNIT_DEST="$HOME/.config/systemd/user/sandbox-broker.service"
install_file "$REPO_ROOT/systemd-user/sandbox-broker.service" "$UNIT_DEST" 0644
# Operational policy (git mode, worker disk, project registry) — loaded via
# EnvironmentFile because systemd Environment= cannot hold JSON values.
ENV_DEST="$HOME/.config/opencode-sandbox/broker.env"
if [[ "$VERIFY" != "1" ]]; then mkdir -p "$(dirname "$ENV_DEST")"; fi
install_file "$REPO_ROOT/systemd-user/broker.env" "$ENV_DEST" 0644
if [[ "$APPLY" == "1" ]]; then
  log "unit + env copied; enable manually with: systemctl --user daemon-reload && systemctl --user enable --now sandbox-broker"
fi

# --- 4. opencode plugins -----------------------------------------------------
log "step 4: opencode plugins (sandbox-tools, routing-guard, lib)"
PLUGIN_DEST="$HOME/.config/opencode/plugins"
if [[ "$VERIFY" != "1" ]]; then mkdir -p "$PLUGIN_DEST/lib"; fi
for f in sandbox-tools.ts routing-guard.ts lib/broker-client.ts lib/reviewer-relay-core.ts lib/session-agent-binding.ts reviewer-relay-transport.ts lib/host-tool-approval.ts lib/apply-preview-guard.ts lib/sandbox-edit-core.ts lib/legacy-sdd-tools.ts; do
  install_file "$REPO_ROOT/opencode/plugins/$f" "$PLUGIN_DEST/$f" 0644
done

# --- 5. pinned ce:review validator helper ------------------------------------
log "step 5: pinned ce:review validator helper"
REVIEW_HELPER_DIR="$STATE_DIR/review-helper"
REVIEW_HELPER_DEST="$REVIEW_HELPER_DIR/validate-review.mjs"
REVIEW_HELPER_PIN="$REVIEW_HELPER_DIR/pin.json"
BROKER_ENV_DEST="$HOME/.config/opencode-sandbox/broker.env"
REVIEW_HELPER_CACHE="$HOME/.cache/opencode/packages"
mapfile -t REVIEW_HELPER_CANDIDATES < <(/usr/bin/find "$REVIEW_HELPER_CACHE" -type f -path '*/skills/ce-review/scripts/validate-review.mjs' -print 2>/dev/null)
REVIEW_HELPER_SOURCES=()
REVIEW_HELPER_VERSIONS=()
REVIEW_HELPER_SOURCE=""
REVIEW_HELPER_VERSION=""
version_is_greater() {
  local candidate="$1" selected="$2" c_major c_minor c_patch s_major s_minor s_patch
  IFS=. read -r c_major c_minor c_patch <<<"$candidate"
  IFS=. read -r s_major s_minor s_patch <<<"$selected"
  (( 10#$c_major > 10#$s_major )) && return 0
  (( 10#$c_major < 10#$s_major )) && return 1
  (( 10#$c_minor > 10#$s_minor )) && return 0
  (( 10#$c_minor < 10#$s_minor )) && return 1
  (( 10#$c_patch > 10#$s_patch ))
}
for helper_source in "${REVIEW_HELPER_CANDIDATES[@]}"; do
  if [[ "$helper_source" =~ /systematic@([0-9]+\.[0-9]+\.[0-9]+)/ ]]; then
    candidate_version="${BASH_REMATCH[1]}"
    REVIEW_HELPER_SOURCES+=("$helper_source")
    REVIEW_HELPER_VERSIONS+=("$candidate_version")
    if [[ -z "$REVIEW_HELPER_SOURCE" ]] || version_is_greater "$candidate_version" "$REVIEW_HELPER_VERSION"; then
      REVIEW_HELPER_SOURCE="$helper_source"
      REVIEW_HELPER_VERSION="$candidate_version"
    fi
  else
    log "review helper ignored non-version package source: $helper_source"
  fi
done
if [[ -z "$REVIEW_HELPER_SOURCE" ]]; then
  log "error: REVIEW_HELPER_SOURCE_MISSING: no versioned ce:review validate-review.mjs found under $REVIEW_HELPER_CACHE"
  exit 1
fi
REVIEW_HELPER_SHA256="$(sha256sum "$REVIEW_HELPER_SOURCE" | cut -d ' ' -f 1)"
for helper_source in "${REVIEW_HELPER_SOURCES[@]}"; do
  [[ "$helper_source" == "$REVIEW_HELPER_SOURCE" ]] || log "review helper other version/source seen: $helper_source"
done
if [[ "$VERIFY" == "1" ]]; then
  VERIFY_EXPECTED_DESTINATIONS+=("$REVIEW_HELPER_DEST")
  if [[ ! -f "$REVIEW_HELPER_PIN" || -L "$REVIEW_HELPER_PIN" ]]; then
    log "DRIFT $REVIEW_HELPER_PIN: pin record absent or not a regular file"
    DRIFT=1
  else
    RECORDED_VERSION="$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$REVIEW_HELPER_PIN")"
    if [[ "$RECORDED_VERSION" != "$REVIEW_HELPER_VERSION" ]]; then
      log "DRIFT review helper version changed: recorded $RECORDED_VERSION, cache has $REVIEW_HELPER_VERSION; deliberate --apply required"
      DRIFT=1
    fi
  fi
  if [[ ! -f "$REVIEW_HELPER_DEST" || -L "$REVIEW_HELPER_DEST" ]]; then
    log "DRIFT $REVIEW_HELPER_DEST: absent or not a regular file"
    DRIFT=1
  elif [[ "$(stat -c '%a' "$REVIEW_HELPER_DEST")" != "600" ]]; then
    log "DRIFT $REVIEW_HELPER_DEST: mode differs (expected 0600)"
    DRIFT=1
  fi
  if [[ ! -d "$REVIEW_HELPER_DIR" || "$(stat -c '%a' "$REVIEW_HELPER_DIR" 2>/dev/null || true)" != "700" ]]; then
    log "DRIFT $REVIEW_HELPER_DIR: mode differs (expected directory 0700)"
    DRIFT=1
  fi
  RECORDED_PATH="$(sed -n 's/^BROKER_REVIEW_HELPER_PATH=//p' "$BROKER_ENV_DEST" 2>/dev/null | tail -n 1)"
  if [[ "$RECORDED_PATH" != "$REVIEW_HELPER_DEST" ]]; then
    log "DRIFT $BROKER_ENV_DEST: live config helper path differs from pinned destination"
    DRIFT=1
  fi
  RECORDED_HASH="$(sed -n 's/^BROKER_REVIEW_HELPER_SHA256=//p' "$BROKER_ENV_DEST" 2>/dev/null | tail -n 1)"
  PINNED_HASH="$(sha256sum "$REVIEW_HELPER_DEST" 2>/dev/null | cut -d ' ' -f 1 || true)"
  if [[ -z "$RECORDED_HASH" || "$PINNED_HASH" != "$RECORDED_HASH" ]]; then
    log "DRIFT $REVIEW_HELPER_DEST: live config hash differs from pinned bytes"
    DRIFT=1
  fi
  if [[ "$PINNED_HASH" != "$REVIEW_HELPER_SHA256" ]]; then
    log "DRIFT $REVIEW_HELPER_DEST: pinned sha256 differs from current package-cache source"
    DRIFT=1
  fi
  if [[ "$DRIFT" == "0" ]]; then
    VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
    log "review helper pin verified: selected $REVIEW_HELPER_VERSION $REVIEW_HELPER_SOURCE sha256 $REVIEW_HELPER_SHA256"
  fi
else
  log "review helper selected $REVIEW_HELPER_VERSION $REVIEW_HELPER_SOURCE; sha256 $REVIEW_HELPER_SHA256"
  if [[ "$APPLY" == "1" ]]; then
    mkdir -p "$REVIEW_HELPER_DIR"
    chmod 700 "$REVIEW_HELPER_DIR"
    cp "$REVIEW_HELPER_SOURCE" "$REVIEW_HELPER_DEST"
    chmod 600 "$REVIEW_HELPER_DEST"
    printf '{"version":"%s","source":"%s","sha256":"%s"}\n' "$REVIEW_HELPER_VERSION" "$REVIEW_HELPER_SOURCE" "$REVIEW_HELPER_SHA256" >"$REVIEW_HELPER_PIN"
    chmod 600 "$REVIEW_HELPER_PIN"
    sed -i '/^BROKER_REVIEW_HELPER_PATH=/d; /^BROKER_REVIEW_HELPER_SHA256=/d' "$BROKER_ENV_DEST"
    printf 'BROKER_REVIEW_HELPER_PATH=%s\nBROKER_REVIEW_HELPER_SHA256=%s\n' "$REVIEW_HELPER_DEST" "$REVIEW_HELPER_SHA256" >>"$BROKER_ENV_DEST"
    journal "review-helper-pin" "$REVIEW_HELPER_SOURCE" "$REVIEW_HELPER_DEST" "$REVIEW_HELPER_VERSION $REVIEW_HELPER_SHA256"
  fi
fi

verify_stale_destinations() {
  local timestamp action source destination detail expected expected_dest
  if [[ ! -e "$JOURNAL" && ! -L "$JOURNAL" ]]; then
    VERIFY_STALE_CHECK_SKIPPED=1
    log "stale destination check skipped: install journal is absent"
    return 0
  fi
  if [[ -L "$JOURNAL" || ! -f "$JOURNAL" || ! -r "$JOURNAL" ]]; then
    log "error: install journal is unusable: $JOURNAL"
    return 1
  fi
  while IFS=$'\t' read -r timestamp action source destination detail; do
    [[ "$action" == "file" || "$action" == "symlink" ]] || continue
    case "$destination" in
      "$HOME/.config/nono/profiles/"*|"$HOME/.config/systemd/user/"*|"$HOME/.config/opencode-sandbox/"*|"$PLUGIN_DEST/"*) ;;
      *) continue ;;
    esac
    expected=0
    for expected_dest in "${VERIFY_EXPECTED_DESTINATIONS[@]}"; do
      if [[ "$destination" == "$expected_dest" ]]; then expected=1; break; fi
    done
    [[ "$expected" == "1" ]] && continue
    [[ "$destination" == *.bak-* ]] && continue
    [[ -e "$destination" || -L "$destination" ]] || continue
    [[ -d "$destination" ]] && continue
    log "drift $destination: stale installed destination"
    DRIFT=1
  done <"$JOURNAL"
}

# --- summary -----------------------------------------------------------------
if [[ "$VERIFY" == "1" ]]; then
  if ! verify_stale_destinations; then
    exit 1
  fi
  if ! BACKUP_COUNT="$(count_all_backups)"; then
    exit 1
  fi
  if [[ "${#VERIFY_EXPECTED_DESTINATIONS[@]}" -eq 0 ]]; then
    log "verification failed: no installed destinations were enumerated"
    exit 1
  fi
  if [[ "$DRIFT" == "1" ]]; then
    log "verification failed: installed files differ from repository"
    exit 1
  fi
  if [[ "$VERIFY_STALE_CHECK_SKIPPED" == "1" ]]; then
    # Exit 2 distinguishes a fresh-install journal absence from full verification.
    log "verification incomplete: $VERIFIED_COUNT installed files verified; $BACKUP_COUNT installer backups; stale destination check skipped (install journal is absent); config fragment excluded (manual merge; no installed counterpart)"
    exit 2
  fi
  log "verification passed: $VERIFIED_COUNT installed files verified; $BACKUP_COUNT installer backups; config fragment excluded (manual merge; no installed counterpart)"
  exit 0
fi
log "done."
if [[ "$APPLY" != "1" ]]; then
  log "dry-run — nothing was installed. Re-run with --apply ONLY after manual review."
else
  log "applied. reverse with: scripts/rollback"
fi
