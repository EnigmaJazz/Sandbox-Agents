#!/usr/bin/env bash
#
# install-user-files — idempotent installer for the LATER gates (Gate 2+).
#
# NOT to be run at Gate 1 and MUST NOT be run by an agent without the user's
# explicit manual approval after reviewing docs/manual-verification.md.
# Default mode is --dry-run: it only prints what it would do and the diffs.
#
# Installs (in order):
#   1. nono profile        -> ~/.config/nono/profiles/opencode-secure.json
#   2. opencode config     -> merges the permission FRAGMENT into the user's
#                             opencode.json — creates a diff artifact and a
#                             .bak first; NEVER overwrites silently
#   3. systemd user unit   -> ~/.config/systemd/user/sandbox-broker.service
#   4. opencode plugins    -> ~/.config/opencode/plugins/{sandbox-tools,routing-guard,lib}
#
# Every installed file gets a timestamped .bak unless one exists already.
# A journal of install actions is written to the broker state dir so
# scripts/rollback can reverse them exactly.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=scripts/secure-launcher.conf
source "$SCRIPT_DIR/secure-launcher.conf"

STATE_DIR="${BROKER_STATE_DIR:-$HOME/.local/state/opencode-sandbox}"
JOURNAL="$STATE_DIR/install-journal.tsv"

APPLY=0
VERIFY=0
PRUNE_BACKUPS=0
for argument in "$@"; do
  case "$argument" in
    --apply) APPLY=1 ;;
    --verify) VERIFY=1 ;;
    --prune-backups) PRUNE_BACKUPS=1 ;;
    --dry-run) ;;
    *) echo "usage: $0 [--dry-run|--apply|--verify|--prune-backups]" >&2; exit 2 ;;
  esac
done
if [[ "$VERIFY" == "1" && "$PRUNE_BACKUPS" == "1" ]]; then
  echo "[install] backup pruning is not allowed in verify mode" >&2
  exit 2
fi
if [[ "$PRUNE_BACKUPS" == "1" && "$APPLY" == "1" ]]; then
  echo "[install] --prune-backups cannot be combined with --apply" >&2
  exit 2
fi

# Verification and explicit pruning must not create or modify installer state.
if [[ "$VERIFY" != "1" && "$PRUNE_BACKUPS" != "1" ]]; then
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
fi
DRIFT=0
VERIFIED_COUNT=0
VERIFY_EXPECTED_DESTINATIONS=()

log() {
  echo "[install] $*"
}

journal() { # action kind source dest
  if [[ "$APPLY" == "1" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$1" "$2" "$3" "$4" >>"$JOURNAL"
  fi
}

prune_destination_backups() { # destination [protected backup]
  local destination="$1" protected="${2:-}" directory name output
  directory="$(dirname "$destination")"
  name="$(basename "$destination")"
  if ! output="$(find "$directory" -maxdepth 1 -type f -regextype posix-extended -regex ".*/${name//./\\.}\\.bak-[0-9]{14}" -printf '%f\n' 2>&1)"; then
    log "error: cannot list installer backups for $destination: $output" >&2
    return 1
  fi
  local -a backups=()
  if [[ -n "$output" ]]; then
    mapfile -t backups < <(printf '%s\n' "$output" | sort -r)
  fi
  local retained=0 backup_path
  for backup_path in "${backups[@]}"; do
    backup_path="$directory/$backup_path"
    retained=$((retained + 1))
    if (( retained > 3 )) && [[ "$backup_path" != "$protected" ]]; then
      if rm -- "$backup_path"; then
        log "deleted old backup $backup_path"
      else
        log "error: cannot remove installer backup $backup_path" >&2
        return 1
      fi
    fi
  done
}

backup() { # file -> creates file.bak-<ts> if it exists and no bak yet
  local f="$1"
  [[ -f "$f" ]] || return 0
  local bak="$f.bak-$(date +%Y%m%d%H%M%S)"
  [[ -e "$bak" ]] && return 0
  cp -p "$f" "$bak"
  log "backed up $f -> $bak"
  prune_destination_backups "$f" "$bak"
}

managed_destinations() {
  local root="$HOME/.config/opencode/plugins"
  printf '%s\n' \
    "$HOME/.config/nono/profiles/opencode-secure.json" \
    "$HOME/.config/systemd/user/sandbox-broker.service" \
    "$HOME/.config/opencode-sandbox/broker.env" \
    "$root/sandbox-tools.ts" "$root/routing-guard.ts" \
    "$root/lib/broker-client.ts" "$root/lib/reviewer-relay-core.ts" \
    "$root/lib/session-agent-binding.ts" "$root/reviewer-relay-transport.ts" \
    "$root/lib/host-tool-approval.ts" "$root/lib/apply-preview-guard.ts" \
    "$root/lib/sandbox-edit-core.ts" "$root/lib/legacy-sdd-tools.ts"
}

prune_all_backups() {
  local destination failed=0
  while IFS= read -r destination; do
    prune_destination_backups "$destination" || failed=1
  done < <(managed_destinations)
  return "$failed"
}

count_all_backups() {
  local destination directory name output count=0
  while IFS= read -r destination; do
    directory="$(dirname "$destination")"
    name="$(basename "$destination")"
    if ! output="$(find "$directory" -maxdepth 1 -type f -regextype posix-extended -regex ".*/${name//./\\.}\\.bak-[0-9]{14}" -printf x 2>&1)"; then
      log "error: cannot list installer backups for $destination: $output" >&2
      return 1
    fi
    count=$((count + ${#output}))
  done < <(managed_destinations)
  printf '%s' "$count"
}

if [[ "$PRUNE_BACKUPS" == "1" ]]; then
  if prune_all_backups; then
    log "backup pruning complete"
    exit 0
  fi
  exit 1
fi

install_file() { # src dest mode
  local src="$1" dest="$2" mode="$3"
  if [[ "$VERIFY" == "1" ]]; then
    VERIFY_EXPECTED_DESTINATIONS+=("$dest")
    if [[ -L "$dest" || -d "$dest" ]]; then
      log "drift $dest: type differs (expected regular file)"
      DRIFT=1
    elif [[ ! -e "$dest" ]]; then
      log "drift $dest: absent"
      DRIFT=1
    elif [[ ! -f "$dest" ]]; then
      log "drift $dest: type differs (expected regular file)"
      DRIFT=1
    elif ! cmp -s "$src" "$dest"; then
      log "drift $dest: content differs"
      DRIFT=1
    elif [[ "$(stat -c '%a' "$dest")" != "${mode#0}" ]]; then
      log "drift $dest: mode differs"
      DRIFT=1
    else
      VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
    fi
    return 0
  fi
  if [[ -f "$dest" ]] && ! cmp -s "$src" "$dest"; then
    backup "$dest"
  fi
  log "install $src -> $dest (mode $mode)"
  if [[ "$APPLY" == "1" ]]; then
    install -m "$mode" "$src" "$dest"
  fi
  journal "file" "$src" "$dest" ""
}

# --- 1. nono profile ---------------------------------------------------------
NONO_DEST="$HOME/.config/nono/profiles/opencode-secure.json"
NONO_SOURCE="$REPO_ROOT/nono/profile/opencode-secure.json"
log "step 1: nono profile"
if [[ "$VERIFY" == "1" ]]; then
  VERIFY_EXPECTED_DESTINATIONS+=("$NONO_DEST")
  if [[ ! -e "$NONO_DEST" && ! -L "$NONO_DEST" ]]; then
    log "drift $NONO_DEST: absent"
    DRIFT=1
  elif [[ ! -L "$NONO_DEST" ]]; then
    log "drift $NONO_DEST: type differs (expected symlink)"
    DRIFT=1
  elif [[ "$(readlink "$NONO_DEST")" != "$NONO_SOURCE" ]]; then
    log "drift $NONO_DEST: link target differs"
    DRIFT=1
  else
    VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
    log "verified $NONO_DEST (expected symlink)"
  fi
else
  if [[ "$APPLY" == "1" ]]; then
    "$NONO_BIN" profile validate "$REPO_ROOT/nono/profile/opencode-secure.json" >/dev/null
  fi
  if [[ -L "$NONO_DEST" ]] && [[ "$(readlink "$NONO_DEST")" == "$NONO_SOURCE" ]]; then
    log "already linked $NONO_DEST -> $NONO_SOURCE"
  else
    if [[ -f "$NONO_DEST" && ! -L "$NONO_DEST" ]]; then
      backup "$NONO_DEST"
    fi
    log "link $NONO_SOURCE -> $NONO_DEST (symlink; not a copy)"
    if [[ "$APPLY" == "1" ]]; then
      mkdir -p "$(dirname "$NONO_DEST")"
      rm -f "$NONO_DEST"
      ln -s "$NONO_SOURCE" "$NONO_DEST"
    fi
    journal "symlink" "$NONO_SOURCE" "$NONO_DEST" ""
  fi
fi

# --- 2. opencode config fragment merge --------------------------------------
log "step 2: opencode permission fragment (merge with diff FIRST)"
OC_CONF="$HOME/.config/opencode/opencode.json"
FRAGMENT="$REPO_ROOT/opencode/config-fragments/sandbox-permissions.jsonc"
if [[ ! -f "$OC_CONF" ]]; then
  log "no opencode.json found at $OC_CONF — fragment NOT applied; refusing to create config"
else
  # Produce the exact diff the user must review before any merge happens.
  # The merge itself is manual: apply sandbox-permissions.jsonc's
  # "permission" block after reviewing this diff. Never merge blindly.
  log "merge target: $OC_CONF"
  log "MERGE IS MANUAL — review fragment + existing config; this script does not merge JSON."
  journal "fragment-review" "$FRAGMENT" "$OC_CONF" "manual merge required"
fi

# --- 3. systemd user unit + broker env -----------------------------------
log "step 3: systemd user unit + broker.env (NOT enabled until Gate 4 review)"
UNIT_DEST="$HOME/.config/systemd/user/sandbox-broker.service"
install_file "$REPO_ROOT/systemd-user/sandbox-broker.service" "$UNIT_DEST" 0644
# Operational policy (git mode, worker disk, project registry) — loaded via
# EnvironmentFile because systemd Environment= cannot hold JSON values.
ENV_DEST="$HOME/.config/opencode-sandbox/broker.env"
if [[ "$VERIFY" != "1" ]]; then mkdir -p "$(dirname "$ENV_DEST")"; fi
install_file "$REPO_ROOT/systemd-user/broker.env" "$ENV_DEST" 0644
if [[ "$APPLY" == "1" ]]; then
  log "unit + env copied; enable manually with: systemctl --user daemon-reload && systemctl --user enable --now sandbox-broker"
fi

# --- 4. opencode plugins -----------------------------------------------------
log "step 4: opencode plugins (sandbox-tools, routing-guard, lib)"
PLUGIN_DEST="$HOME/.config/opencode/plugins"
if [[ "$VERIFY" != "1" ]]; then mkdir -p "$PLUGIN_DEST/lib"; fi
for f in sandbox-tools.ts routing-guard.ts lib/broker-client.ts lib/reviewer-relay-core.ts lib/session-agent-binding.ts reviewer-relay-transport.ts lib/host-tool-approval.ts lib/apply-preview-guard.ts lib/sandbox-edit-core.ts lib/legacy-sdd-tools.ts; do
  install_file "$REPO_ROOT/opencode/plugins/$f" "$PLUGIN_DEST/$f" 0644
done

verify_stale_destinations() {
  local timestamp action source destination detail expected expected_dest
  if [[ ! -f "$JOURNAL" || -L "$JOURNAL" || ! -r "$JOURNAL" ]]; then
    log "stale destination check unavailable: install journal is missing or unreadable"
    return 0
  fi
  while IFS=$'\t' read -r timestamp action source destination detail; do
    [[ "$action" == "file" || "$action" == "symlink" ]] || continue
    case "$destination" in
      "$HOME/.config/nono/profiles/"*|"$HOME/.config/systemd/user/"*|"$HOME/.config/opencode-sandbox/"*|"$PLUGIN_DEST/"*) ;;
      *) continue ;;
    esac
    expected=0
    for expected_dest in "${VERIFY_EXPECTED_DESTINATIONS[@]}"; do
      if [[ "$destination" == "$expected_dest" ]]; then expected=1; break; fi
    done
    [[ "$expected" == "1" ]] && continue
    [[ "$destination" == *.bak-* ]] && continue
    [[ -e "$destination" || -L "$destination" ]] || continue
    [[ -d "$destination" ]] && continue
    log "drift $destination: stale installed destination"
    DRIFT=1
  done <"$JOURNAL"
}

# --- summary -----------------------------------------------------------------
if [[ "$VERIFY" == "1" ]]; then
  verify_stale_destinations
  BACKUP_COUNT="$(count_all_backups)"
  if [[ "${#VERIFY_EXPECTED_DESTINATIONS[@]}" -eq 0 ]]; then
    log "verification failed: no installed destinations were enumerated"
    exit 1
  fi
  if [[ "$DRIFT" == "1" ]]; then
    log "verification failed: installed files differ from repository"
    exit 1
  fi
  log "verification passed: $VERIFIED_COUNT installed files verified; $BACKUP_COUNT installer backups; config fragment excluded (manual merge; no installed counterpart)"
  exit 0
fi
log "done."
if [[ "$APPLY" != "1" ]]; then
  log "dry-run — nothing was installed. Re-run with --apply ONLY after manual review."
else
  log "applied. reverse with: scripts/rollback"
fi
