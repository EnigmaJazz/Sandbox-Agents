#!/usr/bin/env bash
#
# start-secure-opencode-v2 - launch the secured OpenCode V2 server (docs/upgrades/opencode-v2.md, workstream V6).
# The V2 twin of scripts/start-secure-opencode: same control-directory refusal rules, but its own binary, XDG roots,
# port (4097), nono profile and password. It never touches the V1 tree, binary or port.
#
# Exit codes: 3 refused start directory, 4 missing or wrong binary/profile, 6 missing or unsafe password file.
# NOT INSTALLED - delivery is manual (S17).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/secure-launcher-v2.conf"
PROFILE_FILE="$SCRIPT_DIR/../nono/profile/opencode-v2-secure.json"

CONTROL_DIR_OVERRIDE=""
[[ "${1:-}" == "--control-dir" ]] && CONTROL_DIR_OVERRIDE="${2:?}"
[[ -n "$CONTROL_DIR_OVERRIDE" ]] && CONTROL_DIR="$CONTROL_DIR_OVERRIDE"
BOOTSTRAP_WORKSPACE="/home/james/ai-workspace/workflow_optimisation"
CWD_CANON="$(realpath -m "$PWD")"
CONTROL_CANON="$(realpath -m "$CONTROL_DIR")"
BOOTSTRAP_CANON="$(realpath -m "$BOOTSTRAP_WORKSPACE")"
# The control directory (including one given with --control-dir) must itself be a safe place: never inside a project
# root, and never a git checkout. Otherwise naming a project as the control dir would skip the start-directory refusals.
for root in "${PROJECT_ROOTS[@]}"; do
  ROOT_CANON="$(realpath -m "$root")"
  case "$CONTROL_CANON" in "$ROOT_CANON"|"$ROOT_CANON"/*)
    echo "refusing: the control dir is inside a project root: $CONTROL_DIR" >&2
    exit 3 ;;
  esac
done
if [[ -e "$CONTROL_CANON/.git" ]]; then
  echo "refusing: the control dir is a git checkout: $CONTROL_DIR" >&2; exit 3
fi
if [[ "$CWD_CANON" == "$CONTROL_CANON" || "$CWD_CANON" == "$BOOTSTRAP_CANON" ]]; then
  : # allowed: control dir or approved bootstrap workspace
else
  for root in "${PROJECT_ROOTS[@]}"; do
    [[ "$(realpath -m "$root")" == "$BOOTSTRAP_CANON" ]] && continue
    ROOT_CANON="$(realpath -m "$root")"
    case "$CWD_CANON" in "$ROOT_CANON"|"$ROOT_CANON"/*)
      echo "refusing to start secure opencode from project dir: $PWD" >&2
      echo "cd to the control dir first: $CONTROL_DIR" >&2
      echo "or to the approved bootstrap workspace: $BOOTSTRAP_WORKSPACE" >&2
      exit 3 ;;
    esac
  done
fi
if [[ -d "$CWD_CANON/.git" && "$CWD_CANON" != "$CONTROL_CANON" && "$CWD_CANON" != "$BOOTSTRAP_CANON" ]]; then
  echo "refusing to start secure opencode from a git checkout: $PWD" >&2; exit 3
fi

# The V2 binary must exist and must not be (or sit inside) the V1 install.
V2_BIN_CANON="$(realpath -m "$V2_BIN")"
V1_CANON="$(realpath -m "$HOME/.opencode")"
case "$V2_BIN_CANON" in "$V1_CANON"|"$V1_CANON"/*)
  echo "refusing: the V2 binary resolves into the V1 install ($V1_CANON)" >&2; exit 4 ;;
esac
for bin in "$NONO_BIN" "$V2_BIN"; do [[ -x "$bin" ]] || { echo "missing required binary: $bin" >&2; exit 4; }; done
[[ -f "$PROFILE_FILE" ]] || { echo "V2 nono profile missing in repo; cannot continue" >&2; exit 4; }

# The server password: a file only the owner can read. It is never echoed, logged or passed as an argument.
[[ -f "$V2_PASSWORD_FILE" ]] || { echo "missing V2 server-password file: $V2_PASSWORD_FILE (create it, mode 0600)" >&2; exit 6; }
if [[ "$(stat -c '%a' "$V2_PASSWORD_FILE")" != "600" || "$(stat -c '%u' "$V2_PASSWORD_FILE")" != "$(id -u)" ]]; then
  echo "refusing: server-password file must be owned by you with mode 0600: $V2_PASSWORD_FILE" >&2; exit 6
fi
OPENCODE_SERVER_PASSWORD="$(<"$V2_PASSWORD_FILE")"
[[ -n "$OPENCODE_SERVER_PASSWORD" ]] || { echo "refusing: V2 server-password file is empty" >&2; exit 6; }

mkdir -p "$CONTROL_DIR" "$V2_XDG_CONFIG_HOME" "$V2_XDG_DATA_HOME" "$V2_XDG_STATE_HOME" "$V2_XDG_CACHE_HOME" "$V2_XDG_DATA_HOME/tmp"
chmod 700 "$CONTROL_DIR" "$V2_ROOT"
echo "validating nono profile..."
"$NONO_BIN" profile validate "$PROFILE_FILE" >/dev/null
"$NONO_BIN" run --dry-run --profile "$PROFILE_FILE" -- true >/dev/null
echo "starting secured opencode V2 at ${V2_HOSTNAME}:${V2_PORT} (profile: ${V2_NONO_PROFILE})"
echo "control dir: $CONTROL_DIR"
echo "v2 root: $V2_ROOT (cwd: $PWD)"

# OpenCode V2 gets its own XDG roots, but ONLY inside the sandbox, as an `env` wrapper around the server. They must not be
# exported to nono itself: nono keeps its state under $XDG_STATE_HOME/nono, which would then sit inside the profile's
# writable V2 state grant, and nono refuses to start ("overlaps protected nono state root"). OPENCODE_DISABLE_CLAUDE_CODE
# hides ~/.claude skills (the nono profile denies ~/.claude and ~/.agents at the OS level, which is the control that also
# covers ~/.agents). The password travels in the environment only: exported here, inherited by nono and the server.
# OpenCode V2 2.2.0/2.2.2 removes OPENCODE_SERVER_PASSWORD and OPENCODE_PASSWORD from the environment of its shell tool and
# of MCP servers it starts, while other variables are inherited (opencode-v2-probe FINDINGS-3.md); in-process plugins can
# still read it, so install only reviewed plugins.
# The Systematic plugin reads its user config from $HOME/.config/opencode regardless of XDG_CONFIG_HOME, and the V2 profile does
# not grant the V1 tree, so the server runs with a HOME inside the (read-only) V2 config root that holds only that overlay.
# scripts/derive-v2-config.py writes it; refuse to start without it rather than run Systematic against the wrong HOME.
V2_SERVER_HOME="$V2_XDG_CONFIG_HOME/home"
[[ -f "$V2_SERVER_HOME/.config/opencode/systematic.jsonc" ]] || { echo "V2 server home missing its systematic.jsonc; re-run scripts/derive-v2-config.py --apply" >&2; exit 4; }
export OPENCODE_SERVER_PASSWORD
# The service has no TMPDIR and the profile grants only $TMPDIR, so SQLite had no writable temp directory: any query big enough
# to spill to a temp file failed with "unable to open database file". Magic Context treats that as fatal and refused every turn,
# which V2 recorded as a user interrupt (found 2026-10-30). SQLITE_TMPDIR scopes the fix to SQLite and points it inside the
# already-writable V2 data root, without moving every other temp file the server and its plugins create.
# The routing guard builds its log, workflow-key and kill-switch paths from this root. Unset, it uses $HOME, i.e. the V1
# tree, which the V2 profile does not grant (EACCES); the V2 data grant is writable.
exec "$NONO_BIN" run --profile "$PROFILE_FILE" -- env \
  XDG_CONFIG_HOME="$V2_XDG_CONFIG_HOME" XDG_DATA_HOME="$V2_XDG_DATA_HOME" XDG_STATE_HOME="$V2_XDG_STATE_HOME" XDG_CACHE_HOME="$V2_XDG_CACHE_HOME" \
  HOME="$V2_SERVER_HOME" SYSTEMATIC_ROUTING_GUARD_STATE_ROOT="$V2_XDG_DATA_HOME" SQLITE_TMPDIR="$V2_XDG_DATA_HOME/tmp" \
  OPENCODE_V2_RELAY_HOME="$HOME" OPENCODE_V2_RUNTIME_BIN_DIR="$(dirname "$V2_BIN")" OPENCODE_DISABLE_CLAUDE_CODE=1 OPENCODE_DISABLE_AUTOUPDATE=1 npm_config_cache="$V2_XDG_CACHE_HOME/npm-cache" \
  "$V2_BIN" serve --hostname "$V2_HOSTNAME" --port "$V2_PORT"
