# broker.env — operational environment for sandbox-broker.service.
#
# Installed to ~/.config/opencode-sandbox/broker.env by install-user-files.
# Loaded via EnvironmentFile (systemd Environment= cannot hold JSON values).
# Trusted configuration only — never secrets (§26). No credentials here.

# Gate 5+: real git snapshot/result plumbing (was "planned" pre-Gate 5).
BROKER_GIT_MODE=real

# Prepared worker root disk (debian + git + nobody-owned /work), built by
# scripts/build-worker-image. The broker clones it per worker at create time.
BROKER_WORKER_ROOT_DISK=/home/james/.local/share/opencode-sandbox/worker-image/worker.ext4

# Approved project registry (S7: trusted config, never request payloads).
# Every path must be a canonical absolute git repo path. Extend here, then:
#   scripts/install-user-files --apply && systemctl --user restart sandbox-broker
BROKER_PROJECTS=[{"id":"sandbox-integration","path":"/home/james/agent-sandbox-integration"},{"id":"tasker-tesla","path":"/home/james/ai-workspace/tasker/tesla"},{"id":"kinver-proxy","path":"/mnt/ai_storage/kinver-hub/proxy"},{"id":"weight-loss","path":"/home/james/weight_loss"},{"id":"opencode-workspace","path":"/home/james/opencode-workspace"},{"id":"peak-redir","path":"/home/james/peak-redir"},{"id":"mem-opt","path":"/home/james/mem-opt"}]

# Bootstrap window: relax S17 protected-security-file rejection so broker/
# and plugin/ changes can ride the native sandbox apply. REVERT to the full
# list (or remove this var) before final acceptance (Rule B).
BROKER_PROTECTED_SECURITY_FILES=["broker/src/**","broker/package.json","broker/tsconfig.json","nono/profile/**","opencode/plugins/**","opencode/config-fragments/**","systemd-user/**","scripts/**","tests/security/**","tests/acceptance/**","docs/threat-model.md"]

# Approval preview limit: the broker gate and the plugin preview share this.
BROKER_MAX_APPLY_DIFF_LINES=200

# Copy-tool allowlist: exact absolute host files sandbox_copy_out/in may use (S15).
BROKER_EXTERNAL_COPY_TARGETS=["/home/james/.config/opencode/AGENTS.md","/home/james/.config/opencode/opencode.json"]
